{
  "name": "vscode-php-create-class-multi-dir",
  "displayName": "PHP Create Class (PSR-4 Multi-dir Fix)",
  "description": "Patched: Create Class/Interface/Trait/Enum from context menu. Fixed to support PSR-4 namespaces with multiple directory mappings. Original extension: https://marketplace.visualstudio.com/items?itemName=jaguadoromero.vscode-php-create-class",
  "version": "1.17.7",
  "publisher": "HomelessCoder",
  "author": {
    "name": "Evgenii (HomelessCoder)",
    "url": "https://github.com/HomelessCoder"
  },
  "contributors": [
    {
      "name": "Juan Aguado",
      "url": "https://github.com/jaguadoromero"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/HomelessCoder/vscode-php-create-class"
  },
  "homepage": "https://github.com/HomelessCoder/vscode-php-create-class/blob/master/README.md",
  "engines": {
    "vscode": "^1.56.0"
  },
  "categories": [
    "Other"
  ],
  "license": "MIT",
  "icon": "icon.png",
  "keywords": [
    "php",
    "create",
    "class",
    "interface",
    "trait",
    "enum",
    "psr-4"
  ],
  "galleryBanner": {
    "color": "#b2b5d7",
    "theme": "light"
  },
  "activationEvents": [
    "workspaceContains:**/composer.json"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "phpCreateClassMultiDir.createClass",
        "category": "PHP",
        "title": "Class"
      },
      {
        "command": "phpCreateClassMultiDir.createInterface",
        "category": "PHP",
        "title": "Interface"
      },
      {
        "command": "phpCreateClassMultiDir.createTrait",
        "category": "PHP",
        "title": "Trait"
      },
      {
        "command": "phpCreateClassMultiDir.createEnum",
        "category": "PHP",
        "title": "Enum"
      }
    ],
    "submenus": [
      {
        "id": "phpCreateClassMultiDir.menu",
        "label": "New PHP..."
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "phpCreateClassMultiDir.menu",
          "group": "navigation@-1"
        }
      ],
      "phpCreateClassMultiDir.menu": [
        {
          "command": "phpCreateClassMultiDir.createClass",
          "when": "explorerResourceIsFolder && phpCreateClassMultiDir.activated",
          "group": "phpCreateClassMultiDir"
        },
        {
          "command": "phpCreateClassMultiDir.createInterface",
          "when": "explorerResourceIsFolder && phpCreateClassMultiDir.activated",
          "group": "phpCreateClassMultiDir"
        },
        {
          "command": "phpCreateClassMultiDir.createTrait",
          "when": "explorerResourceIsFolder && phpCreateClassMultiDir.activated",
          "group": "phpCreateClassMultiDir"
        },
        {
          "command": "phpCreateClassMultiDir.createEnum",
          "when": "explorerResourceIsFolder && phpCreateClassMultiDir.activated",
          "group": "phpCreateClassMultiDir"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "PHP Create Class (PSR-4 Multi-dir Fix)",
      "properties": {
        "phpCreateClassMultiDir.strictTypes": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Set `strict_types` directive when creating a file"
        },
        "phpCreateClassMultiDir.finalClass": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Set `final` modifier when creating a class"
        },
        "phpCreateClassMultiDir.readonlyClass": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Set `readonly` modifier when creating a class"
        },
        "phpCreateClassMultiDir.composerFilePath": {
          "type": "string",
          "default": null,
          "markdownDescription": "Set `composer.json` location path (relative to project root folder)"
        }
      }
    }
  },
  "devDependencies": {
    "@types/glob": "^7.1.3",
    "@types/mocha": "^8.2.2",
    "@types/node": "14.x",
    "@types/vscode": "^1.56.0",
    "@typescript-eslint/eslint-plugin": "^4.26.0",
    "@typescript-eslint/parser": "^4.26.0",
    "eslint": "^7.27.0",
    "glob": "^7.1.7",
    "mocha": "^8.4.0",
    "typescript": "^4.3.2",
    "vscode-test": "^1.5.2"
  }
}